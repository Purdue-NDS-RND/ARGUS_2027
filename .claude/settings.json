{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -f*r*)",
      "Bash(rm -f*R*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm --recursive*)",
      "Bash(rm * --recursive*)",
      "Bash(gh pr merge *)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api -f *)",
      "Bash(gh api * -f *)",
      "Bash(gh api -F *)",
      "Bash(gh api * -F *)",
      "Bash(gh api --field*)",
      "Bash(gh api * --field*)",
      "Bash(gh api --raw-field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api --input*)",
      "Bash(gh api * --input*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
