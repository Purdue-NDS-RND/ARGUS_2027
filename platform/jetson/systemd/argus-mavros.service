[Unit]
Description=ARGUS: MAVROS on the flight controller (/dev/argus/pixhawk)
After=network.target

[Service]
Type=simple
User=@USER@
EnvironmentFile=/etc/argus/boot.env
ExecStart=@REPO@/platform/jetson/boot/argus-boot.sh mavros
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
