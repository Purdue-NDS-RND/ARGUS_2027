<?xml version="1.0"?>
<model>
  <name>Iris with ArduPilot, survey camera profile</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Generated by sim/sensor_profiles.py: the ardupilot_gazebo iris_with_ardupilot model with a downward camera of the 'survey' profile (1280x720 at 10 Hz).
  </description>
  <depend>
    <model>
      <uri>model://iris_with_ardupilot</uri>
    </model>
  </depend>
</model>
