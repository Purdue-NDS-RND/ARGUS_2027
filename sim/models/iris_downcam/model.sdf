<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    iris_with_ardupilot (ArduPilot plugin, rotors, IMU) plus a fixed downward
    camera.

    Camera: 640x360, update_rate 30 Hz. horizontal_fov is
    2 * atan(1920 / 2334.99647) = 1.37635 rad (78.9 deg). That is the field
    of view of the calibrated camera in package_delivery_demo.yaml
    (camera_fx_px 2334.99647 at camera_calibration_width_px 3840). The
    mission scales fx to the image width it receives, so this matches at any
    16:9 resolution.

    640x360, not 1280x720: on a club laptop (Iris Xe) 1280x720 gave 8.6 Hz
    on /camera/image and 640x360 gave 12.2 Hz, both at a real-time factor
    near 0.5. See docs/results/2026-11-04-sim-baseline.md. On a faster
    machine 1280x720 works without any other change.

    Orientation: tracking_projection.py assumes the top of the image points
    forward, image right points right, and the optical axis points down.
    A Gazebo camera looks along its +X, with image up along +Z and image
    right along -Y. Pitching it +90 deg about the body Y axis (FLU) maps
    +X to down, +Z to forward and leaves Y alone, which gives exactly that.
  -->
  <model name="iris_downcam">
    <include>
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <link name="downcam_link">
      <!-- Under the body, between the standoffs. -->
      <pose relative_to="iris_with_ardupilot::iris_with_standoffs::base_link">0 0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="downcam" type="camera">
        <pose>0 0 0 0 1.5707963 0</pose>
        <gz_frame_id>downcam_link</gz_frame_id>
        <topic>downcam/image</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <camera>
          <horizontal_fov>1.37635</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>500</far>
          </clip>
          <camera_info_topic>downcam/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </link>

    <joint name="downcam_joint" type="fixed">
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>downcam_link</child>
    </joint>
  </model>
</sdf>
