<?xml version="1.0"?>
<model>
  <name>Iris with ArduPilot and a downward camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    The ardupilot_gazebo iris_with_ardupilot model with a camera hard-mounted
    under the body, looking straight down, matching the delivery mission's
    camera intrinsics.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_ardupilot</uri>
    </model>
  </depend>
</model>
