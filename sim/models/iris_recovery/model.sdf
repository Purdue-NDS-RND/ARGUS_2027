<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Generated by sim/sensor_profiles.py from iris_camera.sdf.template: the 'recovery' camera profile. Do not edit.

    iris_with_ardupilot plus a fixed downward camera, 640x360 at 30 Hz,
    horizontal_fov 1.37635 rad: the IMX519's as calibrated, as in iris_downcam.
    And a flow camera: 320x200 mono at 20 Hz, horizontal_fov 1.2 rad.
    And a hook: a 0.5 m rod on a damped two-axis joint under the body, for the recovery bucket (REC-8).
  -->
  <model name="iris_recovery">
    <include>
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <link name="downcam_link">
      <!-- Under the body, between the standoffs. -->
      <pose relative_to="iris_with_ardupilot::iris_with_standoffs::base_link">0 0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="downcam" type="camera">
        <pose>0 0 0 0 1.5707963 0</pose>
        <gz_frame_id>downcam_link</gz_frame_id>
        <topic>downcam/image</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <camera>
          <horizontal_fov>1.37635</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>500</far>
          </clip>
          <camera_info_topic>downcam/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </link>

    <joint name="downcam_joint" type="fixed">
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>downcam_link</child>
    </joint>

    <link name="flowcam_link">
      <!-- The optical-flow camera: beside the downward camera, looking down, global shutter (Gazebo's cameras all are). -->
      <pose relative_to="iris_with_ardupilot::iris_with_standoffs::base_link">0.05 0 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="flowcam" type="camera">
        <pose>0 0 0 0 1.5707963 0</pose>
        <gz_frame_id>flowcam_link</gz_frame_id>
        <topic>flowcam/image</topic>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>0</visualize>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>320</width>
            <height>200</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>500</far>
          </clip>
          <camera_info_topic>flowcam/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </link>

    <joint name="flowcam_joint" type="fixed">
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>flowcam_link</child>
    </joint>

    <link name="hook_link">
      <!-- The hook: a rod hinged under the body. No collision: it passes through what it touches (the ground
           under a standing vehicle, the handle it goes under). What it holds is joined to it by the payload bridge. -->
      <pose relative_to="iris_with_ardupilot::iris_with_standoffs::base_link">0 0 -0.3 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00104167</ixx><iyy>0.00104167</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="rod">
        <geometry><cylinder><radius>0.004</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="hook_joint" type="universal">
      <pose>0 0 0.25 0 0 0</pose>
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>hook_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1</lower><upper>1</upper></limit>
        <dynamics><damping>0.2</damping></dynamics>
      </axis>
      <axis2>
        <xyz>0 1 0</xyz>
        <limit><lower>-1</lower><upper>1</upper></limit>
        <dynamics><damping>0.2</damping></dynamics>
      </axis2>
    </joint>
  </model>
</sdf>
